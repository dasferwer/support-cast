          },
          {
            "name": "handling_minutes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 60,
              "exclusiveMinimum": 0,
              "default": 8,
              "title": "Handling Minutes"
            }
          },
          {
            "name": "productive_hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 12,
              "exclusiveMinimum": 0,
              "default": 6,
